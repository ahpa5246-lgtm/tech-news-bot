{
  "type": "object",
  "properties": {
    "decision": {"type": "string", "enum": ["ACCEPT", "REVIEW", "REJECT"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "category": {"type": "string", "minLength": 1},
    "importance_score": {"type": "integer", "minimum": 0, "maximum": 5},
    "summary_ar": {"type": "string"},
    "what_happened": {"type": "string"},
    "why_it_matters": {"type": "string"},
    "key_facts": {"type": "array", "items": {"type": "string"}},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {"type": "string"},
          "verification_status": {"type": "string", "enum": ["SUPPORTED", "UNSUPPORTED", "UNCERTAIN", "NOT_CHECKED"]},
          "evidence": {"type": ["string", "null"]}
        },
        "required": ["claim", "verification_status", "evidence"],
        "additionalProperties": false
      }
    },
    "safety_status": {"type": "string", "enum": ["SAFE", "SENSITIVE_REVIEW", "UNSAFE"]},
    "needs_review": {"type": "boolean"},
    "needs_research": {"type": "boolean"},
    "rejection_reason": {"type": ["string", "null"]}
  },
  "required": ["decision", "confidence", "category", "importance_score", "summary_ar", "what_happened", "why_it_matters", "key_facts", "claims", "safety_status", "needs_review", "needs_research", "rejection_reason"],
  "additionalProperties": false
}
